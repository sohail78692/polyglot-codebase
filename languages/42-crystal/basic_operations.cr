# ==========================================
# Program: Basic Operations in Crystal (+, -, *, /, //, %)
# ==========================================
a = 20
b = 6

puts "a = #{a}, b = #{b}"
puts "Addition (a + b)        : #{a + b}"
puts "Subtraction (a - b)     : #{a - b}"
puts "Multiplication (a * b)  : #{a * b}"
puts "Float Division (a / b)  : #{a / b}"
puts "Integer Division (//)   : #{a // b}" # // is integer division in Crystal
puts "Modulo (a % b)          : #{a % b}"
